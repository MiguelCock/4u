AI_TRAINING_URL=http://ai-training:80
# Needed as of the app-integration follow-up to #24 - only to verify
# caller bearer tokens on POST /correct_position (this service still
# never queries Postgres for anything else). Needs the service_role key,
# same reasoning as every other Supabase-backed service (see root
# CLAUDE.md's Environment configuration section).
SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
SUPABASE_SERVICE_ROLE_KEY=<SUBSTITUTE_SUPABASE_SERVICE_ROLE_KEY>


# Optional tuning of visual-match gating (app/matching.py; defaults shown).
# Change, then restart the container - no app release needed. See
# docs/TUNING.md for what each does and how to read the logged diagnostics.
# POSITIONING_MIN_MATCH_SCORE=0.75
# POSITIONING_MAX_MATCH_DISTANCE_M=20
# POSITIONING_MATCH_ACCURACY_FACTOR=2.5
# POSITIONING_HEADING_GATE_DEG=60
# POSITIONING_VISUAL_BASE_SIGMA_M=3
# POSITIONING_VISUAL_SIGMA_PER_M=0.3
# POSITIONING_MAHALANOBIS_GATE=9.21
# POSITIONING_SEARCH_RADIUS_M=60
# POSITIONING_SEARCH_LIMIT=5
# GPS offset model (app/kalman.py make_filter): typical size and how long it
# takes to change; 0 sigma disables it. Accuracy scale for the GPS noise.
# POSITIONING_GPS_BIAS_SIGMA_M=4
# POSITIONING_GPS_BIAS_TAU_S=120
# POSITIONING_GPS_SIGMA_FACTOR=1
