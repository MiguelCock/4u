QDRANT_URL=<SUBSTITUTE_QDRANT_URL>
QDRANT_KEY=<SUBSTITUTE_QDRANT_KEY>
# Needed as of #24 - only to verify caller bearer tokens / admin role on the
# write endpoints (this service still never queries Postgres for anything
# else). Needs the service_role key, same reasoning as the other services
# (see root CLAUDE.md's Environment configuration section).
SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
SUPABASE_SERVICE_ROLE_KEY=<SUBSTITUTE_SUPABASE_SERVICE_ROLE_KEY>
# Photo embedding model (app/embedding.py): eigenplaces (default) or effnet.
# Each has its own Qdrant collection - after switching, run the admin
# "Re-index verified points", and set backend-positioning's
# POSITIONING_MIN_MATCH_SCORE for its scale (0.25 / 0.75).
# EMBEDDING_MODEL=eigenplaces
